# Next.js web process (copy to apps/web/.env.local for local overrides).
# Staging: set server-side values in the hosting provider's encrypted settings.
# Required in staging/production; use a dedicated managed PostgreSQL URL.
HAUI_COMPASS_WEB_DATABASE_URL=
# Private Vercel Blob store for staging/production document objects. Vercel-connected
# projects normally use BLOB_STORE_ID + its short-lived OIDC token; BLOB_READ_WRITE_TOKEN
# is for non-Vercel/local synthetic verification and server-side SDK access.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=
# Required for Compass chat and PDF extraction. Vercel Services injects this
# server-side from the web -> api binding; local development may use loopback.
COMPASS_API_URL=http://127.0.0.1:8001
# Leave empty locally. Behind a trusted HTTPS proxy, set the exact public origin.
COMPASS_WEB_ORIGIN=
# Google sign-in (server only). Create a Google OAuth Web application client.
# Redirect URI must exactly match the callback registered in Google Cloud.
# Local example: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Same randomly generated value in both web and FastAPI process environments.
# Backend-only: never prefix this with NEXT_PUBLIC_. No insecure default.
COMPASS_SERVICE_KEY=
# Server-only JSON account-ID -> assigned class IDs, identical on web and API.
# Empty means no lecturers. Never enable COMPASS_DEMO_AUTH on Preview.
COMPASS_LECTURER_GRANTS={}
# API-only JSON class-ID -> enrolled simulated account IDs. Empty means no enrollment.
# Configure on the FastAPI service (shared project env is also supported).
# Only initialized accounts count; cohorts smaller than five are suppressed.
COMPASS_SIMULATED_CLASS_ROSTERS={}
# Legacy fixed dashboard fixtures are disabled by default; isolated tests only.
COMPASS_LECTURER_FIXTURE=0

# Optional local-only setting. Staging/production must leave disabled (unset or 0).
# COMPASS_DEMO_AUTH=1

# Local-only filesystem override for the current SQLite demo stores.
# This is not persistent storage for a serverless deployment.
# COMPASS_STORAGE_DIR=
