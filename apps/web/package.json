{
  "name": "haui-compass-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:3100": "next dev --hostname 127.0.0.1 --port 3100",
    "prebuild": "node scripts/check-production-environment.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:config": "node --experimental-strip-types --test tests/*.test.mjs ../../scripts/test-staging-evidence.mjs",
    "test:postgres": "npm run db:migrate && playwright test tests/postgres-persistence.spec.ts --project=desktop",
    "db:migrate": "node scripts/migrate-web-postgres.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/blob": "^2.8.1",
    "google-auth-library": "^11.3.1",
    "katex": "^0.19.1",
    "next": "^16.3.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "katex": "$katex",
    "typescript-eslint": "8.46.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0"
  }
}
