# Shared backend environment template. Copy into an untracked local env file.
# Never commit real credentials. Staging values belong in the hosting provider's
# encrypted environment settings, not in this file.

# Required when running PostgreSQL-backed APIs or Alembic migrations.
# Staging: use a dedicated managed PostgreSQL connection string.
HAUI_COMPASS_DATABASE_URL=postgresql+psycopg://haui:change-me@localhost:54329/haui_compass
# Local/integration-test only; do not configure this in the staging runtime.
HAUI_COMPASS_TEST_DATABASE_URL=postgresql+psycopg://haui:change-me@localhost:54330/haui_compass_test
# Backward-compatible fallback for HAUI_COMPASS_DATABASE_URL (server-side only).
DATABASE_URL=

# Optional LLM configuration. Keep the credential server-side in every environment.
HAUI_COMPASS_LLM_ENABLED=false
HAUI_COMPASS_LLM_MODEL=gpt-5-mini-2025-08-07
HAUI_COMPASS_LLM_BASE_URL=https://api.openai.com/v1
HAUI_COMPASS_LLM_TIMEOUT_SECONDS=8
OPENAI_API_KEY=
